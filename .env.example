# Copia este archivo como .env.local y completa con tus datos.
# Los valores reales están en: Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Solo en el servidor: necesaria para invitar usuarios desde el panel (/admin/usuarios).
# Nunca se expone al navegador porque no lleva el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
